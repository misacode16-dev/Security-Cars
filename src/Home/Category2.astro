---
const categorias2 = [
  { titulo: "Luces para Auto", img: "/categoria-luces.webp", link: "/categoria/luces" },
  { titulo: "Cámara de retroceso", img: "/categoria-camara.webp", link: "/categoria/camara-de-retroceso" },
];
---



<section class="max-w-[1200px] mx-auto">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mb-9">
    {categorias2.map((cate2) => (
      <div class="relative h-[280px] md:h-[310px] bg-cover bg-center flex items-end md:items-center justify-end overflow-hidden" style={`background-image: url('${cate2.img}')`}>
        <div class="bg-[rgba(18,18,18,0.72)] w-full md:w-[58%] h-auto min-h-[130px] md:h-[220px] px-5 py-4 md:px-8 md:py-0 flex flex-col justify-center items-start text-white">
          <h2 class="text-[21px] md:text-[32px] font-extrabold leading-tight mb-3 md:mb-5 text-white">{cate2.titulo}</h2>
      <a href={cate2.link} class="inline-block bg-[#0445ec] text-white text-xs font-extrabold px-5 py-2.5 md:py-3 uppercase tracking-wide transition-transform hover:scale-103">Ver productos</a>
    </div>
  </div>
))}
  </div>
</section>
