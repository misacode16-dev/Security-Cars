---
const features = [
  { icon: Truck, title: 'Envíos a nivel nacional', desc: 'Envíos a todo el Perú' },
  { icon: Lock, title: 'Pago 100% seguro', desc: 'Se Aceptan Todas Las Tarjetas.' },
  { icon: Headset, title: 'Constestamos todas tus dudas', desc: 'Si tienes alguna pregunta, avísanos.' },
];

import { Truck, Lock, Headset } from '@lucide/astro';
---



<section class="max-w-[1200px] mx-auto">
    <div class="flex flex-column flex-wrap justify-center gap-5">
  {features.map((feature) => (
    <div class="relative overflow-hidden bg-[#f7f7f7] px-6 py-7 flex items-center gap-4.5 rounded-sm">
      <div class="text-[#111] flex items-center justify-center min-w-[40px] z-[2]">
        <feature.icon class="w-8 h-8" />
      </div>
      <div class="z-[2]">
        <h4 class="text-[15px] font-bold text-[#111] mb-1">{feature.title}</h4>
        <p class="text-xs text-[#777]">{feature.desc}</p>
      </div>
    </div>
  ))}
</div>
</section>