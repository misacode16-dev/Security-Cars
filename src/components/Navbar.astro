---
import { Menu, X, ChevronDown } from '@lucide/astro';
import categories from '../data/categories.json';

const categoryOptions = categories.map((cat) => ({
  name: cat.name,
  href: `/categoria/${cat.slug}`,
}));

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/catalogo-de-productos.pdf', label: 'Catálogo' },
];
---

<header class="fixed top-0 left-0 right-0 z-[100] bg-white border-b border-[#e8e8e8]">
  <nav class="max-w-7xl mx-auto h-[55px] px-5 md:px-8 flex justify-between items-center">

    <!-- Logo -->
    <a href="/" class="flex-shrink-0">
      <img src="/logo.webp" alt="Logo" class="h-full w-auto rounded-3xl" />
    </a>

    <!-- Menú escritorio -->
    <div class="hidden lg:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          class="text-[17px] font-medium text-[#1a1a1a] hover:text-[#0445ec] transition-colors duration-200"
          href={link.href}>
          {link.label}
        </a>
      ))}

      <!-- Dropdown Categorías -->
      <div class="relative">
        <button
          id="category-dropdown-btn"
          type="button"
          class="flex items-center gap-1.5 text-[17px] font-medium text-[#1a1a1a] hover:text-[#0445ec] transition-colors duration-200 cursor-pointer">
          Categorías
          <ChevronDown id="category-arrow" class="w-4 h-4 text-[#666] transition-transform duration-200 pointer-events-none" />
        </button>

        <div
          id="category-dropdown-menu"
          class="absolute top-[calc(100%+15px)] right-0 w-[220px] max-h-[70vh] overflow-y-auto bg-white border border-[#e8e8e8] shadow-[0_8px_30px_rgba(0,0,0,0.10)] py-2 z-[101] hidden">
          {categoryOptions.map((cat) => (
            <a
              href={cat.href}
              class="block px-4 py-2.5 text-[14px] text-[#333] hover:bg-[#fff4f0] hover:text-[#0445ec] transition-colors">
              {cat.name}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Botón hamburguesa móvil -->
    <button
      id="menu-btn"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="lg:hidden text-[#1a1a1a] p-2">
      <Menu id="icon-menu" class="w-6 h-6" />
      <X id="icon-close" class="w-6 h-6 hidden" />
    </button>
  </nav>

  <!-- Menú móvil -->
  <div
    id="mobile-menu"
    class="fixed top-[55px] left-0 w-full bg-white border-t border-[#e8e8e8] lg:hidden z-[99] opacity-0 -translate-y-2 pointer-events-none transition-all duration-300 ease-in-out max-h-[calc(100vh-50px)] overflow-y-auto">
    <div class="flex flex-col px-5 py-6 space-y-4">
      {navLinks.map((link) => (
        <a
          class="text-[15px] font-medium text-[#1a1a1a] hover:text-[#0445ec] transition-colors"
          href={link.href}>
          {link.label}
        </a>
      ))}

      <!-- Categorías móvil -->
      <div class="pt-4 border-t border-[#eeeeee]">
        <p class="text-[12px] font-semibold uppercase tracking-widest text-[#aaaaaa] mb-3">Categorías</p>
        <div class="flex flex-col space-y-3">
          {categoryOptions.map((cat) => (
            <a href={cat.href} class="text-[14px] text-[#333] hover:text-[#0445ec] transition-colors">
              {cat.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {

    /* ===== MENÚ HAMBURGUESA MÓVIL ===== */
    const btn = document.getElementById("menu-btn");
    const menu = document.getElementById("mobile-menu");
    const iconMenu = document.getElementById("icon-menu");
    const iconClose = document.getElementById("icon-close");
    let isMenuOpen = false;

    function updateMenu(open) {
      if (!btn || !menu || !iconMenu || !iconClose) return;
      isMenuOpen = open;
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
      menu.classList.toggle("opacity-0", !open);
      menu.classList.toggle("-translate-y-2", !open);
      menu.classList.toggle("pointer-events-none", !open);
      menu.classList.toggle("opacity-100", open);
      menu.classList.toggle("translate-y-0", open);
      iconMenu.classList.toggle("hidden", open);
      iconClose.classList.toggle("hidden", !open);
    }

    function closeMenu() { updateMenu(false); }

    btn?.addEventListener("click", function () { updateMenu(!isMenuOpen); });
    menu?.querySelectorAll("a").forEach(function (link) { link.addEventListener("click", closeMenu); });
    window.addEventListener("scroll", function () { if (isMenuOpen) closeMenu(); }, { passive: true });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape" && isMenuOpen) closeMenu(); });
    document.addEventListener("click", function (e) {
      if (isMenuOpen && !menu.contains(e.target) && !btn.contains(e.target)) closeMenu();
    });

    /* ===== DROPDOWN CATEGORÍAS DESKTOP ===== */
    const catBtn = document.getElementById("category-dropdown-btn");
    const catMenu = document.getElementById("category-dropdown-menu");
    const catArrow = document.getElementById("category-arrow");
    let catOpen = false;

    function openCatMenu() {
      catOpen = true;
      catMenu?.classList.remove("hidden");
      if (catArrow) catArrow.style.transform = "rotate(180deg)";
    }

    function closeCatMenu() {
      catOpen = false;
      catMenu?.classList.add("hidden");
      if (catArrow) catArrow.style.transform = "rotate(0deg)";
    }

    catBtn?.addEventListener("click", function (e) {
      e.stopPropagation();
      e.preventDefault();
      if (catOpen) closeCatMenu(); else openCatMenu();
    });

    catMenu?.querySelectorAll("a").forEach(function (link) { link.addEventListener("click", closeCatMenu); });

    document.addEventListener("click", function (e) {
      if (catOpen && !catMenu.contains(e.target) && !catBtn.contains(e.target)) closeCatMenu();
    });

    document.addEventListener("keydown", function (e) { if (e.key === "Escape" && catOpen) closeCatMenu(); });
  });
</script>