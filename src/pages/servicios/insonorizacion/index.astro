    <script>
    {
        const slider = document.getElementById('slider');
        const beforeWrap = document.getElementById('beforeWrap');
        const divider = document.getElementById('divider');
        const hint = document.getElementById('hint');
 
        let sliderPos = 50;
        let isDragging = false;
        let hintHidden = false;
 
        function setSliderPosition(pos) {
            sliderPos = Math.max(0, Math.min(100, pos));
            beforeWrap.style.width = sliderPos + '%';
            divider.style.left = sliderPos + '%';
            if (!hintHidden && sliderPos !== 50) {
                hint.classList.add('comp-hint--hidden');
                hintHidden = true;
            }
        }
 
        function getSliderPos(clientX) {
            const rect = slider.getBoundingClientRect();
            return ((clientX - rect.left) / rect.width) * 100;
        }
 
        function startDrag(e) {
            isDragging = true;
            slider.classList.add('slider-comp--dragging');
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            setSliderPosition(getSliderPos(clientX));
            if (e.cancelable) e.preventDefault();
        }
 
        function onDrag(e) {
            if (!isDragging) return;
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            setSliderPosition(getSliderPos(clientX));
            if (e.cancelable) e.preventDefault();
        }
 
        function stopDrag() {
            isDragging = false;
            slider.classList.remove('slider-comp--dragging');
        }
 
        slider.addEventListener('mousedown', startDrag);
        window.addEventListener('mousemove', onDrag);
        window.addEventListener('mouseup', stopDrag);
        slider.addEventListener('touchstart', startDrag, { passive: false });
        window.addEventListener('touchmove', onDrag, { passive: false });
        window.addEventListener('touchend', stopDrag);
 
        window.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft') setSliderPosition(sliderPos - 2);
            else if (e.key === 'ArrowRight') setSliderPosition(sliderPos + 2);
        });
 
        setTimeout(() => {
            if (!hintHidden) { hint.classList.add('comp-hint--hidden'); hintHidden = true; }
        }, 5000);
 
        setSliderPosition(50);
    }
    </script>