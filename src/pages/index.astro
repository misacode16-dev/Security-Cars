---
import Layout from '../layouts/Layout.astro';
import { getHomePageSchema } from '../utils/schemas.js';
import products from '../data/products.json';


import Category2 from '../Home/Category2.astro';
import Features from '../Home/Features.astro';
import PopularProducts from '../Home/PopularProducts.astro';
import PopularCategory from '../Home/PopularCategory.astro';
import BestSellers from '../Home/BestSellers.astro';

const homeSchema = getHomePageSchema();

// Se baraja UNA sola vez y se reparte: así ningún producto sale en las dos
// secciones. Solo se consideran productos con stock.
function shuffle(array) {
  const copy = [...array];
  for (let i = copy.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [copy[i], copy[j]] = [copy[j], copy[i]];
  }
  return copy;
}

const shuffled = shuffle(products.filter((p) => p.stock));
const popularProducts = shuffled.slice(0, 5);
const bestSellerProducts = shuffled.slice(5, 15);
---

<Layout
  title="Seguridad y accesorios para tu auto, con instalación incluida"
  description="En Security Cars encuentras alarmas, GPS, cámaras de retroceso, insonorizantes, luces LED y mucho más para tu auto o camioneta. No solo te vendemos el producto: lo instalamos nosotros mismos, para que salgas manejando sin complicarte."
  url="https://security-cars.com"
  structuredData={homeSchema}
>
  <main>
    <PopularCategory />
    <Features />
    <PopularProducts products={popularProducts} />
    <Category2 />
    <BestSellers products={bestSellerProducts} />
  </main>
</Layout>



